# --- DATABASE (TimescaleDB / Postgres) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=clinical_db
# URL for the Node backend to connect (inside docker)
DATABASE_URL=postgresql://postgres:postgres@db:5432/clinical_db

# --- SERVER ---
PORT=3001
NODE_ENV=development

# --- AUTH ---
JWT_SECRET=clinical_system_secure_secret_771
JWT_EXPIRES_IN=7d
