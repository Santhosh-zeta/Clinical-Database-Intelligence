# --- DATABASE (TimescaleDB / Postgres) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=clinical_db
# URL for the Node backend to connect (inside docker)
DATABASE_URL=postgresql://postgres:postgres@db:5432/clinical_db

# --- SERVER ---
PORT=3001
NODE_ENV=development

# --- AUTH ---
# REQUIRED: generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=CHANGE_ME_generate_a_real_secret_before_deploying
JWT_EXPIRES_IN=7d

# --- CORS ---
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:3000

# --- DEMO ACCOUNTS ---
# Only active when NODE_ENV != production
# Default password is 'password123' if not set
DEMO_PASSWORD=password123
